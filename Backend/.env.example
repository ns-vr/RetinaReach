# REQUIRED before deployment: generate a long random secret.
RETINAREACH_JWT_SECRET=replace-with-a-long-random-secret
RETINAREACH_JWT_EXPIRE_MINUTES=60
RETINAREACH_DATA_DIR=./data
RETINAREACH_MAX_UPLOAD_MB=10

# Comma-separated frontend origins. Add your deployed frontend domain here.
RETINAREACH_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5500

# Optional: URL of a separately deployed, evaluated model API.
# Expected POST multipart field "file", JSON response:
# {"status":"complete","prediction_label":"...","prediction_confidence":0.0}
RETINAREACH_INFERENCE_URL=
